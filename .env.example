# Atlassian OAuth 2.0 (3LO) app credentials
# Create at https://developer.atlassian.com/console/myapps/ -> Create -> OAuth 2.0 integration
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=

# Must match the callback URL registered in the Atlassian console exactly.
# Default: http://localhost:8787/oauth/callback
# JIRA_OAUTH_REDIRECT_URI=http://localhost:8787/oauth/callback

# Optional: override the requested scopes (space separated). Default covers
# issues, users, boards and sprints. offline_access is always added.
# JIRA_SCOPES=read:jira-user read:jira-work write:jira-work read:project:jira read:board-scope:jira-software read:sprint:jira-software write:sprint:jira-software read:issue:jira-software

# Optional: pick the Jira site to use when your account has access to more
# than one. Accepts the cloud id, the site name, or the site URL.
# JIRA_DEFAULT_SITE=

# Optional: where tokens and config live. Default: ~/.config/jirum
# JIRUM_CONFIG_DIR=

# Optional: set to 1 to never open a browser automatically; the login URL is still returned/printed.
# JIRUM_NO_BROWSER=
